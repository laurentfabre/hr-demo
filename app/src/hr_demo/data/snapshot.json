  "definitions": [
    {
      "definition_en": "Distinct employees active at the reference date within the displayed scope.",
      "definition_fr": "Nombre de collaborateurs distincts actifs à la date de référence dans le périmètre affiché.",
      "id": "headcount",
      "label_en": "Active headcount",
      "label_fr": "Effectif actif",
      "source": "validation/reference_query.sql",
      "unit": "employees"
    },
    {
      "definition_en": "Voluntary exits during the preceding 365 days divided by average daily headcount over that period, multiplied by 100. No individual probability.",
      "definition_fr": "Départs volontaires sur les 365 jours précédents, divisés par l'effectif quotidien moyen de cette période, multipliés par 100. Aucune probabilité individuelle.",
      "id": "attrition",
      "label_en": "Historical voluntary attrition",
      "label_fr": "Départs volontaires historiques",
      "source": "validation/reference_query.sql",
      "unit": "%"
    },
    {
      "definition_en": "Median calendar days from opening to filling for roles filled during the preceding 365 days.",
      "definition_fr": "Médiane des jours calendaires entre ouverture et pourvoi des postes pourvus durant les 365 jours précédents.",
      "id": "time_to_fill",
      "label_en": "Median time to fill",
      "label_fr": "Délai médian de recrutement",
      "source": "validation/reference_query.sql",
      "unit": "days"
    },
    {
      "definition_en": "Aggregate count of employees with at least 24 months of tenure whose pay is at most 105% of the median of at least three peers with under 12 months of tenure in the same country, job family and level. Synthetic association, not causation. Unavailable when coverage is incomplete.",
      "definition_fr": "Nombre agrégé de collaborateurs ayant au moins 24 mois d'ancienneté dont la rémunération est au plus 105 % de la médiane d'au moins trois pairs ayant moins de 12 mois d'ancienneté, à pays, famille de métier et niveau identiques. Association synthétique, sans causalité. Résultat indisponible si la couverture est incomplète.",
      "id": "pay_compression",
      "label_en": "Pay compression association",
      "label_fr": "Association de compression salariale",
      "source": "validation/reference_query.sql",
      "unit": "employees"
    },
    {
      "definition_en": "Positive assumed demand-minus-capacity gap over 90 days per active FTE, relative to the same measure for the synthetic company including the cohort. A scenario assumption, not a trained-model prediction.",
      "definition_fr": "Écart positif entre demande et capacité supposées sur 90 jours, par ETP actif, rapporté au même indicateur de l'entreprise synthétique incluant la cohorte. Hypothèse de scénario, pas une prédiction issue d'un modèle entraîné.",
      "id": "assumed_capacity_ratio",
      "label_en": "Assumed capacity ratio",
      "label_fr": "Ratio de capacité sous hypothèses",
      "source": "validation/reference_query.sql",
      "unit": "×"
    },
    {
      "definition_en": "Sum over six calendar months of positive monthly demand-minus-capacity gaps after assumed intervention effects. One FTE-month is one full-time person's capacity for one month. Raw values use milli-FTE-months.",
      "definition_fr": "Somme sur six mois calendaires des écarts mensuels positifs entre demande et capacité, après les effets supposés des interventions. Un ETP-mois correspond à la capacité d'une personne à temps plein pendant un mois. Valeurs sources en milli-ETP-mois.",
      "id": "scenario_gap",
      "label_en": "Scenario capacity gap",
      "label_fr": "Écart de capacité du scénario",
      "source": "validation/reference_query.sql",
      "unit": "FTE-months"
    },
    {
      "definition_en": "Intervention counts multiplied by synthetic unit costs: retain €10,000, hire €70,000, redeploy €30,000. Raw values use cents. A proposal for human review; no executed HR action.",
      "definition_fr": "Nombre d'interventions multiplié par leur coût unitaire synthétique : fidéliser 10 000 €, recruter 70 000 €, mobilité 30 000 €. Valeurs sources en centimes. Proposition soumise à revue humaine, sans action RH exécutée.",
      "id": "scenario_cost",
      "label_en": "Assumed scenario cost",
      "label_fr": "Coût supposé du scénario",
      "source": "validation/reference_query.sql",
      "unit": "EUR"
    },
    {
      "definition_en": "Scoped requisitions marked critical and open at the reference date.",
      "definition_fr": "Nombre de postes du périmètre marqués critiques, ouverts à la date de référence.",
      "id": "critical_open_roles",
      "label_en": "Critical open roles",
      "label_fr": "Postes critiques ouverts",
      "source": "validation/reference_query.sql",
      "unit": "roles"
    },
    {
